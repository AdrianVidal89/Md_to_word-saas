# =============================================================================
# MD2Docx SaaS — variables de entorno
# Copia este fichero a `.env` y rellena los valores reales.
# NUNCA commitees el `.env` real (ya está en .gitignore).
# =============================================================================

# --- Supabase ---
# URL del proyecto (Settings -> API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# anon/public key (segura para exponer en el frontend)
SUPABASE_ANON_KEY=eyJhbGciOi...
# service_role key (SOLO backend, nunca en el frontend/cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# JWT secret del proyecto (Settings -> API -> JWT Settings), usado para
# verificar localmente los tokens emitidos por Supabase Auth sin llamada de red
SUPABASE_JWT_SECRET=your-jwt-secret

# --- FastAPI / Backend ---
# Entorno de ejecución: local | staging | production
ENVIRONMENT=local
# Orígenes permitidos para CORS (separados por coma). En producción: dominio de Vercel.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-app.vercel.app
# Puerto en el que corre uvicorn (Render inyecta $PORT en producción)
PORT=8000

# --- Anti-abuso ---
# La conversión genérica (/api/convert) es pública e ilimitada: estos límites
# son anti-abuso (proteger la capa gratuita de Render), no cuotas de negocio.
# Rate-limit por IP: máx. peticiones permitidas por ventana deslizante
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
# Máximo de IPs distintas permitidas en 24h para un usuario 'pro' antes de bloquear (403)
PRO_MAX_IPS_24H=2

# --- API Keys (B2B) ---
# Prefijo usado al generar API keys legibles para el usuario (informativo)
API_KEY_PREFIX=md2docx_live_

# --- Stripe (suscripción Pro: plantillas persistentes + API keys) ---
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_ID_PRO=price_xxx
STRIPE_CHECKOUT_URL=https://buy.stripe.com/test_xxx

# --- Frontend (inyectadas en web/index.html o build step) ---
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
PUBLIC_API_BASE_URL=https://your-backend.onrender.com
